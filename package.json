{
  "name": "casa-domotica",
  "version": "0.1.0",
  "description": "Casa domotica - control Arduino MEGA via Bluetooth SPP (Capacitor + HTML/CSS/JS)",
  "private": true,
  "scripts": {
    "dev": "python -m http.server 5173 --bind 127.0.0.1 --directory www",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android",
    "build:apk": "cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@e-is/capacitor-bluetooth-serial": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  }
}
